{
  "name": "job-hunter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:migrate": "tsx agent/migrate.ts",
    "agent": "tsx agent/run.ts",
    "agent:dry": "tsx agent/run.ts --dry-run",
    "dev": "next dev -p 2000",
    "build": "next build",
    "start": "next start -p 2000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^16.4.6",
    "pdfkit": "^0.21.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
