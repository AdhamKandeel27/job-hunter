# Copy to .env and fill in.

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://jobhunter:jobhunter@localhost:5433/jobhunter

# Gemini (free key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# First pass over many postings (a Flash-Lite model)
GEMINI_MODEL_SCREEN=gemini-3.5-flash-lite
# Eligibility, vetting, scoring, package writing (a Flash model)
GEMINI_MODEL_JUDGE=gemini-3.8-flash
# Model calls per minute; lower it if AI Studio shows a tighter free-tier limit
GEMINI_RPM=8

# Score (0-100) a posting needs to reach the digest
SCORE_CUTOFF=70
# New postings judged per run. The review page can override it for one run.
MAX_POSTINGS_PER_RUN=40

# Email (https://resend.com). Without a key the digest is written to out/ instead.
RESEND_API_KEY=
DIGEST_TO=
DIGEST_FROM=Job agent <onboarding@resend.dev>

# Where the review page runs; used for package links in the digest
APP_URL=http://localhost:2000
